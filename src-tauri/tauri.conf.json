{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaToolsPro",
  "version": "0.5.1",
  "identifier": "com.naturaldevcr.mediatoolspro",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MediaToolsPro",
        "maximized": true,
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/waveforms/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/mediatoolspro/32x32.png",
      "icons/mediatoolspro/128x128.png",
      "icons/mediatoolspro/128x128@2x.png",
      "icons/mediatoolspro/icon.icns",
      "icons/mediatoolspro/icon.ico"
    ],
    "shortDescription": "Estudio local para recortar, dividir y normalizar audio y video",
    "longDescription": "MediaToolsPro permite recortar y dividir archivos locales por duración, capítulos, silencios o marcas manuales, con preescucha A/B, fades y normalización en dos pasadas."
  }
}
